<!DOCTYPE html>
<html lang="zh-Hant">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>植物圖書館遊戲</title>
  <style>
    :root {
      --bg-color: #f4f7f4;
      --card-bg: #ffffff;
      --primary: #2d6a4f;
      --primary-hover: #1b4332;
      --accent: #d8f3dc;
      --text: #1b262c;
      --text-muted: #555b6e;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Noto Sans TC", sans-serif;
    }

    body {
      background-color: var(--bg-color);
      color: var(--text);
      display: flex;
      flex-direction: column;
      align-items: center;
      min-height: 100vh;
      padding: 24px 16px;
    }

    header {
      text-align: center;
      margin-bottom: 24px;
    }

    header h1 {
      font-size: 2rem;
      color: var(--primary);
      margin-bottom: 8px;
    }

    header p {
      color: var(--text-muted);
      font-size: 0.95rem;
    }

    .game-container {
      width: 100%;
      max-width: 600px;
      background: var(--card-bg);
      border-radius: 16px;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
      padding: 28px;
    }

    .status-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
      font-size: 0.95rem;
      font-weight: 600;
      color: var(--primary);
    }

    .card {
      background-color: var(--accent);
      border-radius: 12px;
      padding: 24px;
      text-align: center;
      margin-bottom: 24px;
    }

    .plant-icon {
      font-size: 3rem;
      margin-bottom: 12px;
    }

    .clue-title {
      font-size: 1.1rem;
      font-weight: bold;
      color: var(--primary-hover);
      margin-bottom: 8px;
    }

    .clue-text {
      font-size: 1rem;
      line-height: 1.6;
      color: var(--text);
    }

    .options-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      margin-bottom: 20px;
    }

    .btn-option {
      background: #ffffff;
      border: 2px solid #e0e0e0;
      border-radius: 10px;
      padding: 14px 16px;
      font-size: 1rem;
      font-weight: 600;
      color: var(--text);
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .btn-option:hover {
      border-color: var(--primary);
      background-color: #f7faf8;
    }

    .btn-option.correct {
      background-color: #d1e7dd;
      border-color: #0f5132;
      color: #0f5132;
    }

    .btn-option.wrong {
      background-color: #f8d7da;
      border-color: #842029;
      color: #842029;
    }

    .feedback {
      min-height: 48px;
      text-align: center;
      font-weight: 600;
      margin-bottom: 16px;
      font-size: 0.95rem;
    }

    .btn-next {
      display: block;
      width: 100%;
      background: var(--primary);
      color: #ffffff;
      border: none;
      border-radius: 10px;
      padding: 14px;
      font-size: 1rem;
      font-weight: bold;
      cursor: pointer;
      transition: background 0.2s ease;
    }

    .btn-next:hover {
      background: var(--primary-hover);
    }

    .btn-next:disabled {
      background: #cccccc;
      cursor: not-allowed;
    }

    .result-screen {
      text-align: center;
      padding: 20px 0;
    }

    .result-screen h2 {
      color: var(--primary);
      margin-bottom: 12px;
    }

    .result-screen p {
      font-size: 1.1rem;
      margin-bottom: 24px;
      color: var(--text-muted);
    }
  </style>
</head>
<body>

  <header>
    <h1>🌿 植物圖書館借閱處</h1>
    <p>根據借書證上的植物生態特徵，找出對應的植物名稱！</p>
  </header>

  <main class="game-container">
    <div id="quiz-area">
      <div class="status-bar">
        <span id="level-display">關卡：1 / 3</span>
        <span id="score-display">探索點數：0</span>
      </div>

      <div class="card">
        <div class="plant-icon" id="plant-icon">🌱</div>
        <div class="clue-title">借書線索</div>
        <div class="clue-text" id="clue-text">線索載入中...</div>
      </div>

      <div class="options-grid" id="options-grid"></div>

      <div class="feedback" id="feedback"></div>

      <button id="next-btn" class="btn-next" disabled>下一本藏書</button>
    </div>

    <div id="result-area" class="result-screen" style="display: none;">
      <h2>🎉 借閱登記完成！</h2>
      <p id="final-score-text"></p>
      <button class="btn-next" onclick="restartGame()">重新整理書單</button>
    </div>
  </main>

  <script>
    const questions = [
      {
        icon: "🪴",
        clue: "葉片肥厚多汁，排列呈蓮花座狀，常被種植在辦公桌或庭園角落，象徵富貴與吉祥。",
        options: ["石蓮花", "薄荷", "桂花", "蒲公英"],
        answer: 0,
        desc: "石蓮花屬於景天科多肉植物，葉片多肉質且排列似蓮花。"
      },
      {
        icon: "🌺",
        clue: "花瓣層層疊疊，顏色多變常見大紅色，是校園與綠籬極受歡迎的常綠灌木。",
        options: ["九重葛", "重瓣朱槿", "山茶花", "繁星花"],
        answer: 1,
        desc: "重瓣朱槿為錦葵科木槿屬，花大且花瓣重疊，四季開花。"
      },
      {
        icon: "⭐",
        clue: "聚繖花序頂生，一朵朵微小的小花外觀呈現可愛的五角星形，深受蝴蝶喜愛。",
        options: ["黃金葛", "牽牛花", "繁星花", "向日葵"],
        answer: 2,
        desc: "繁星花花冠筒狀，先端五裂呈星形，蜜源豐富常吸引蝶類。"
      }
    ];

    let currentIdx = 0;
    let score = 0;
    let answered = false;

    const levelDisplay = document.getElementById("level-display");
    const scoreDisplay = document.getElementById("score-display");
    const plantIcon = document.getElementById("plant-icon");
    const clueText = document.getElementById("clue-text");
    const optionsGrid = document.getElementById("options-grid");
    const feedback = document.getElementById("feedback");
    const nextBtn = document.getElementById("next-btn");
    const quizArea = document.getElementById("quiz-area");
    const resultArea = document.getElementById("result-area");
    const finalScoreText = document.getElementById("final-score-text");

    function renderQuestion() {
      answered = false;
      const q = questions[currentIdx];
      levelDisplay.textContent = `關卡：${currentIdx + 1} / ${questions.length}`;
      plantIcon.textContent = q.icon;
      clueText.textContent = q.clue;
      feedback.textContent = "";
      feedback.style.color = "inherit";
      nextBtn.disabled = true;
      optionsGrid.innerHTML = "";

      q.options.forEach((opt, idx) => {
        const btn = document.createElement("button");
        btn.className = "btn-option";
        btn.textContent = opt;
        btn.onclick = () => selectOption(idx, btn);
        optionsGrid.appendChild(btn);
      });
    }

    function selectOption(selectedIdx, btnElement) {
      if (answered) return;
      answered = true;
      const q = questions[currentIdx];
      const buttons = optionsGrid.querySelectorAll(".btn-option");

      if (selectedIdx === q.answer) {
        btnElement.classList.add("correct");
        score += 10;
        scoreDisplay.textContent = `探索點數：${score}`;
        feedback.textContent = `正解！${q.desc}`;
        feedback.style.color = "#0f5132";
      } else {
        btnElement.classList.add("wrong");
        buttons[q.answer].classList.add("correct");
        feedback.textContent = `差一點！正確答案是「${q.options[q.answer]}」。${q.desc}`;
        feedback.style.color = "#842029";
      }

      nextBtn.disabled = false;
    }

    nextBtn.onclick = () => {
      currentIdx++;
      if (currentIdx < questions.length) {
        renderQuestion();
      } else {
        showResult();
      }
    };

    function showResult() {
      quizArea.style.display = "none";
      resultArea.style.display = "block";
      finalScoreText.textContent = `你在本次植物圖書館探索中獲得了 ${score} 點（共 ${questions.length * 10} 點）！`;
    }

    function restartGame() {
      currentIdx = 0;
      score = 0;
      scoreDisplay.textContent = `探索點數：${score}`;
      resultArea.style.display = "none";
      quizArea.style.display = "block";
      renderQuestion();
    }

    renderQuestion();
  </script>
</body>
</html>
